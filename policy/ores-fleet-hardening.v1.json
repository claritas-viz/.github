{
  "api_version": "ores.dev/fleet-hardening/v1",
  "kind": "OrganizationHardeningPolicyBinding",
  "metadata": {
    "organization": "claritas-viz",
    "environment": "production",
    "sql_namespace": "claritas_viz"
  },
  "spec": {
    "inherits": {
      "repository": "ORESoftware/ores-gh-bots",
      "path": "config/hardening-fleet.v1.json"
    },
    "sql": {
      "authority": "organization-local-with-central-mirror",
      "namespace": "claritas_viz",
      "registry": "declarative-migrations/declarative-postgres-migrate.rs"
    },
    "kubernetes": {
      "cluster": "ORESoftware/k8s-cluster",
      "libraries": "ORESoftware/k8s-libs-and-shared-defs"
    },
    "repository_policy_path": ".ores/repository-hardening.v1.json"
  }
}
